# Trading platform configuration.
#
# Copy to .env and fill in. NEVER commit .env - it holds secrets.
# Generate SECRET_KEY and ENCRYPTION_KEY with:  trading-bot generate-key

# =========================================================================== #
# Application
# =========================================================================== #
APP_ENV=development                 # development | test | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# =========================================================================== #
# Trading mode
# =========================================================================== #
# TRADING_MODE is `paper` by default and must stay that way until you have:
#   1. run backtests AND walk-forward validation,
#   2. run paper trading long enough to see real drawdowns,
#   3. read docs/live-trading.md end to end.
#
# Setting TRADING_MODE=live is NOT sufficient on its own: LIVE_TRADING_ENABLED must also be
# true, the API key must be trade-only, and the in-app preflight must pass. Neither switch can
# be flipped from the user interface.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false

# paper | bybit | binance | coinbase | cryptocom
#
# Symbol format differs by venue and is NOT translated for you beyond the obvious case:
#   bybit, binance   BTCUSDT
#   coinbase         BTC-USD     (BTCUSD is accepted and converted)
#   cryptocom        BTC_USDT    (BTCUSDT is accepted and converted)
#
# Coinbase Advanced Trade has NO testnet. EXCHANGE_TESTNET=true is refused for it rather
# than silently routing real orders while the interface says otherwise.
EXCHANGE=paper
EXCHANGE_TESTNET=true

# Leave EMPTY unless you are connecting a real venue. The application stores exchange
# credentials encrypted in the database; these variables exist for single-user desktop
# installs that skip the UI.
#
# The API key MUST have trade permission and MUST NOT have withdrawal permission. A key that
# can withdraw is rejected at connection time.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

PAPER_STARTING_BALANCE=10000
PAPER_QUOTE_CURRENCY=USDT

# Where a paper bot's prices come from: bybit | binance | synthetic
#
# `bybit` and `binance` read that venue's PUBLIC endpoints - no API key, no account, and
# no path from here to an order. The bot still executes against the simulator; only the
# prices are real. This is the combination docs/live-trading.md asks you to rehearse with.
#
# `synthetic` generates a random walk instead. Useful with no internet, but it exercises
# the plumbing rather than the strategy - do not read performance into it.
PAPER_MARKET_DATA=bybit

# =========================================================================== #
# Risk limits (platform ceiling)
# =========================================================================== #
# Per-bot settings can only ever be TIGHTER than these. They are the hard ceiling.
RISK_PER_TRADE=0.005                # 0.5% of equity risked per trade
RISK_MAX_DAILY_LOSS=0.02            # stop trading for the day at 2%
RISK_MAX_WEEKLY_LOSS=0.06
RISK_MAX_DRAWDOWN=0.10              # kill switch at 10% from the high-water mark
RISK_MAX_POSITION_FRACTION=0.25
RISK_MAX_PORTFOLIO_EXPOSURE=1.0
RISK_MAX_ASSET_EXPOSURE=0.35
RISK_MAX_CONCURRENT_POSITIONS=5
RISK_MAX_LEVERAGE=3.0
RISK_MAX_SPREAD_BPS=15
RISK_MAX_SLIPPAGE_BPS=25
RISK_MIN_LIQUIDITY_MULTIPLE=10
RISK_COOLDOWN_SECONDS=300
RISK_MAX_LOSS_STREAK=4
RISK_MAX_DAILY_TRADES=30

# =========================================================================== #
# Database and cache
# =========================================================================== #
# SQLite is fine for a single-user desktop install. Production requires PostgreSQL; the
# application refuses to start with SQLite when APP_ENV=production.
DATABASE_URL=sqlite+aiosqlite:///./data/trading.db
# DATABASE_URL=postgresql+asyncpg://trading:CHANGE_ME@localhost:5432/trading
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Optional. Needed only for multi-worker deployments (shared rate limits, job queue).
REDIS_URL=
REDIS_REQUIRED=false

# Used by docker-compose only.
POSTGRES_USER=trading
POSTGRES_PASSWORD=
POSTGRES_DB=trading

# =========================================================================== #
# Security
# =========================================================================== #
# Generate both with: trading-bot generate-key
# SECRET_KEY signs access tokens.
# ENCRYPTION_KEY encrypts stored exchange credentials. WITHOUT IT, EXCHANGE ACCOUNTS CANNOT
# BE STORED AT ALL - the platform refuses to fall back to plaintext.
# If ENCRYPTION_KEY is lost, every connected exchange account must be reconnected.
SECRET_KEY=
ENCRYPTION_KEY=

ACCESS_TOKEN_TTL_SECONDS=900        # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=1209600   # 14 days
PASSWORD_MIN_LENGTH=12
AUTH_RATE_LIMIT_PER_MINUTE=10

# Require email verification before sign-in. Defaults to true in production, false elsewhere.
# Leaving it true WITHOUT configuring SMTP means new accounts are created but can never sign
# in - startup logs an error if you do that. For a single-operator install, set it to false.
REQUIRE_EMAIL_VERIFICATION=

# =========================================================================== #
# Market data
# =========================================================================== #
MARKET_DATA_MAX_STALENESS_SECONDS=120
MAX_CLOCK_DRIFT_SECONDS=2.0

# =========================================================================== #
# News (optional)
# =========================================================================== #
# News modifies signal confidence and can veto a trade. It can NEVER create one.
# Running with NEWS_PROVIDER=null is a fully supported configuration.
# `rss` is the default and needs no credentials: it reads public feeds from CoinDesk,
# Cointelegraph, Decrypt, Bitcoin Magazine, CryptoSlate and The Block, tags each article with
# the assets it mentions, and filters by the asset a bot trades. One publisher being down
# degrades the feed rather than breaking it.
#
# Running with NEWS_PROVIDER=null is still a fully supported configuration.
NEWS_ENABLED=true
NEWS_PROVIDER=rss                   # rss | null | file | http
NEWS_API_URL=
NEWS_API_KEY=
NEWS_MAX_AGE_MINUTES=180
# How long articles are reused before the feeds are polled again. Lower means fresher news
# and more requests to publishers, some of which rate-limit aggressively.
NEWS_CACHE_SECONDS=60

# =========================================================================== #
# Licensing (optional)
# =========================================================================== #
# Enforcement is off by default: a licensing outage must not become a trading outage.
LICENSE_SERVER_URL=
LICENSE_KEY=
LICENSE_ENFORCEMENT=false
LICENSE_GRACE_PERIOD_HOURS=72

# =========================================================================== #
# Notifications (optional)
# =========================================================================== #
NOTIFICATIONS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost

# =========================================================================== #
# Ports (docker-compose)
# =========================================================================== #
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_CONCURRENCY=1
